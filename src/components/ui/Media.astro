---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

// Images are optimized at build (ImageMetadata) into a <picture> with AVIF and WebP at several widths; the browser
// picks one using `sizes`. The CMS preview passes plain URLs (including unsaved blob: uploads), which stay <img>.
type Variant = "logo" | "logoSmall" | "hero" | "figure" | "gallery" | "video" | "card" | "media" | "portrait" | "sponsor";

const variants: Record<Variant, string> = {
  logo: "h-10 w-auto lg:h-12",
  logoSmall: "h-10 w-auto",
  hero: "aspect-[5/4] h-auto w-full object-cover object-[50%_54%] [mask-image:linear-gradient(to_bottom,transparent_0,#000_30%,#000_75%,transparent_100%)] sm:aspect-[16/5.6]",
  figure: "aspect-square h-auto w-full object-contain",
  gallery: "aspect-[4/3] h-auto w-full bg-base-200 object-cover",
  // YouTube's hqdefault thumbnail is 4:3 with black bars around 16:9 video; crop to the picture.
  video: "aspect-video h-auto w-full bg-neutral object-cover",
  card: "aspect-[3/2] h-auto w-full bg-base-200 object-cover",
  media: "h-auto w-full bg-base-200 object-cover",
  portrait: "size-14 shrink-0 bg-base-200 object-cover",
  sponsor: "h-14 w-auto max-w-40 object-contain",
};

// Candidate widths per variant (never above the source's own width) and the default `sizes` for its usual layout.
// Callers pass `sizes` when a variant sits in a different layout (e.g. `card` in Venues vs CardGrid).
const widthsFor: Record<Variant, number[]> = {
  logo: [160, 320],
  logoSmall: [160, 320],
  hero: [640, 1024, 1440, 1920],
  figure: [400, 800],
  gallery: [400, 600, 900],
  video: [480],
  card: [400, 720, 1080],
  media: [480, 800, 1240],
  portrait: [112, 224],
  sponsor: [160, 320],
};
const defaultSizes: Record<Variant, string> = {
  logo: "160px",
  logoSmall: "160px",
  hero: "100vw",
  figure: "(min-width: 74rem) 28rem, (min-width: 48rem) 40vw, 100vw",
  gallery: "(min-width: 768px) 33vw, 50vw",
  video: "(min-width: 768px) 50vw, 100vw",
  card: "(min-width: 768px) 33vw, 100vw",
  media: "(min-width: 768px) 40vw, 100vw",
  portrait: "56px",
  sponsor: "160px",
};

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width: number;
  height: number;
  variant: Variant;
  loading?: "lazy" | "eager";
  sizes?: string;
}
const { src, alt, width, height, variant, loading = "lazy", sizes } = Astro.props;
// Like astro:assets <Image>: a source smaller than the requested width keeps its own shape (no crop to the
// requested aspect); a larger one is cropped to width × height. Variants with a CSS aspect crop visually anyway.
const fitHeight = (image: ImageMetadata) => (image.width < width ? Math.round((width * image.height) / image.width) : height);
// Fallback <img> format follows the source: PNG keeps transparency, WebP (every CMS upload) stays WebP, the rest JPG.
// (Astro would otherwise fall back to PNG for WebP sources — large files for photos.)
const fallbackFor = (image: ImageMetadata) => (image.format === "png" ? "png" : image.format === "webp" ? "webp" : "jpg");
// No upscaling: keep widths the source can supply; a small source gets just its own width.
const pickWidths = (image: ImageMetadata, v: Variant) => {
  const fit = widthsFor[v].filter((w) => w <= image.width);
  return fit.length ? fit : [image.width];
};
---

{
  typeof src === "string" ? (
    <img src={src} alt={alt} width={width} height={height} class={variants[variant]} loading={loading} decoding="async" />
  ) : src.format === "svg" ? (
    // SVGs pass through untouched: converting one to AVIF/WebP fails the build (Astro refuses to rasterize SVG).
    <img src={src.src} alt={alt} width={width} height={height} class={variants[variant]} loading={loading} decoding="async" />
  ) : (
    <Picture
      src={src}
      alt={alt}
      width={width}
      height={fitHeight(src)}
      formats={["avif", "webp"]}
      fallbackFormat={fallbackFor(src)}
      widths={pickWidths(src, variant)}
      sizes={sizes ?? defaultSizes[variant]}
      class={variants[variant]}
      pictureAttributes={{ class: "block" }}
      loading={loading}
      fit="cover"
    />
  )
}
