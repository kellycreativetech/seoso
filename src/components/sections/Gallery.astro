---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import type { Section as SectionData } from "../../lib/sections";
import Media from "../ui/Media.astro";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

// Black-and-white thumbnails that open full size in the lightbox (lib/lightbox.ts), with next/previous.
// Without JavaScript each thumbnail links to its full-size image.
interface Props {
  section: Extract<SectionData, { type: "gallery" }>;
  index: number;
}
const { section, index } = Astro.props;
const { eyebrow, heading, intro, images, anchorId } = section;
const headingId = `heading-${anchorId ?? index}`;

// Full-size versions for the overlay. The CMS preview passes plain URLs (size unknown, and scripts don't run there).
const FULL_WIDTH = 2000;
const full = await Promise.all(
  images.map(async ({ src }) => {
    if (typeof src === "string") return { href: src, width: 1600, height: 1200 };
    const meta = src as ImageMetadata;
    const width = Math.min(FULL_WIDTH, meta.width);
    const image = await getImage({ src: meta, width });
    return { href: image.src, width, height: Math.round((meta.height / meta.width) * width) };
  }),
);
---

{
  images.length > 0 && (
    <Section id={anchorId} labelledBy={heading ? headingId : undefined}>
      <SectionHeader eyebrow={eyebrow} heading={heading} headingId={headingId}>
        {intro && <p slot="aside">{intro}</p>}
      </SectionHeader>
      <ul data-lightbox class="grid grid-cols-2 gap-3 border-t-2 border-base-content pt-6 sm:gap-4 md:grid-cols-3">
        {images.map((image, i) => (
          <li>
            <figure>
              <a
                href={full[i].href}
                data-pswp-width={full[i].width}
                data-pswp-height={full[i].height}
                class="block grayscale focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
              >
                <Media src={image.src} alt={image.alt} width={600} height={450} variant="gallery" sizes="(min-width: 768px) 33vw, 50vw" />
              </a>
              {image.caption && <figcaption class="mt-2 text-small text-base-content/70">{image.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    </Section>
  )
}

<script>
  import { initLightbox } from "../../lib/lightbox";
  initLightbox();
</script>
