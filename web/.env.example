# Copy to .env.local and fill in. .env.local is git-ignored.
NEXT_PUBLIC_SANITY_PROJECT_ID=cerintdw
NEXT_PUBLIC_SANITY_DATASET=production
# Optional locally; defaults to http://localhost:3333
# NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Required. A Viewer token for draft mode / live preview:
# sanity.io/manage → SEOSO → API → Tokens → Add API token (Viewer),
# or from studio/: npx sanity tokens add "local preview" --role viewer
SANITY_API_READ_TOKEN=
