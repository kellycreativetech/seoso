# macOS
.DS_Store

# Sanity TypeGen intermediate (regenerated by `npm run typegen` in studio)
studio/schema.json

# Root tooling (concurrently)
node_modules/

# Netlify CLI state and local build output
.netlify/

# Tailwind scanner debug logs
tailwindcss-*.log

# Build output and caches at any depth
.next/
out/
dist/
.sanity/
*.tsbuildinfo
next-env.d.ts

# Local env files (templates like .env.example stay committed)
.env*.local
