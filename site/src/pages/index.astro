---
import PageBuilder from "../components/PageBuilder.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getEntry } from "astro:content";
import { loadSnippets } from "../lib/site-data";
import type { Section } from "../lib/sections";

const page = await getEntry("pages", "home");
const snippets = await loadSnippets();
---

<SiteLayout>
  <PageBuilder sections={(page?.data.sections ?? []) as Section[]} rotateTones snippets={snippets} />
</SiteLayout>
