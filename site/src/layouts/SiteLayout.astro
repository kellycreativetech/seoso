---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import NavBehavior from "../components/site/NavBehavior.astro";
import SiteDrawer from "../components/site/SiteDrawer.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import { loadSite } from "../lib/site-data";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
  description?: string | null;
  image?: ImageMetadata | null;
  noIndex?: boolean;
}
const { title, description, image, noIndex } = Astro.props;
const data = await loadSite();
const shareImage = image ?? data.site.defaultSeoImage;
const ogImage = shareImage
  ? new URL((await getImage({ src: shareImage, width: 1200, height: 630, fit: "cover" })).src, Astro.site).href
  : undefined;
const siteName = data.site.organizationName ?? data.site.title;
const fullTitle = title ? `${title} | ${data.site.title}` : siteName;
---

<BaseLayout title={fullTitle} description={description ?? data.site.description ?? undefined} image={ogImage} noIndex={noIndex}>
  <SiteDrawer data={data}>
    <a href="#main" class="btn btn-sm absolute top-2 left-2 z-50 -translate-y-20 focus:translate-y-0">Skip to content</a>
    <SiteHeader data={data} />
    <main id="main" class="flex-1"><slot /></main>
    <SiteFooter data={data} />
  </SiteDrawer>
  <NavBehavior />
</BaseLayout>
