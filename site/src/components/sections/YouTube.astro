---
// Privacy-friendly YouTube embed (youtube-nocookie), 16:9.
const { youtubeId, title } = Astro.props as { youtubeId: string; title: string };
---

<iframe
  src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
  title={title}
  loading="lazy"
  allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
  allowfullscreen
  class="aspect-video w-full bg-neutral"></iframe>
