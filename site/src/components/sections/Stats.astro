---
import type { Section as SectionData } from "../../lib/sections";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

// Two to four big figures with short labels (daisyUI stats, flattened to the site's ruled style).
interface Props {
  section: Extract<SectionData, { type: "stats" }>;
  index: number;
}
const { section, index } = Astro.props;
const { eyebrow, heading, stats, anchorId } = section;
const headingId = `heading-${anchorId ?? index}`;
---

<Section id={anchorId} labelledBy={heading ? headingId : undefined}>
  <SectionHeader eyebrow={eyebrow} heading={heading} headingId={headingId} />
  <div class="stats stats-vertical w-full rounded-none border-t-2 border-base-content bg-transparent sm:stats-horizontal">
    {
      stats.map((stat) => (
        <div class="stat border-base-300 px-0 py-8 sm:px-8 sm:first:pl-0">
          <div class="stat-value font-serif text-h1 font-light text-secondary tabular-nums sm:text-display">{stat.value}</div>
          <div class="stat-desc mt-2 text-small font-semibold tracking-[0.14em] whitespace-normal text-base-content/70 uppercase">
            {stat.label}
          </div>
        </div>
      ))
    }
  </div>
</Section>
