---
import Eyebrow from "../ui/Eyebrow.astro";
import Heading from "../ui/Heading.astro";

// Eyebrow + serif heading on the 12-column measure, with an optional note on the right (`aside` slot).
interface Props {
  eyebrow?: string | null;
  heading?: string | null;
  headingId?: string;
}
const { eyebrow, heading, headingId } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

{
  (eyebrow || heading || hasAside) && (
    <div class="mb-10 grid grid-cols-1 items-end gap-6 sm:mb-16 md:grid-cols-12">
      {eyebrow && (
        <div class="md:col-span-12">
          <Eyebrow>{eyebrow}</Eyebrow>
        </div>
      )}
      {heading && (
        <h2 id={headingId} class="font-serif text-h3 tracking-[-0.01em] text-balance sm:text-h2 md:col-span-7">
          <Heading text={heading} />
        </h2>
      )}
      {hasAside && (
        <div class="max-w-[30ch] text-base-content/70 md:col-span-4 md:col-start-9">
          <slot name="aside" />
        </div>
      )}
    </div>
  )
}
