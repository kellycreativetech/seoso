---
import { renderMarkdown, renderMarkdownInline } from "../../lib/markdown";

// Renders a Markdown field. Element styles are arbitrary variants on the wrapper (no authored CSS selectors).
type Variant = "prose" | "inline" | "note";
const variants: Record<Variant, string> = {
  prose:
    "[&_a]:link [&_a]:link-secondary [&_blockquote]:my-6 [&_blockquote]:border-l-2 [&_blockquote]:border-primary [&_blockquote]:pl-5 [&_blockquote]:font-serif [&_blockquote]:text-lead [&_blockquote]:italic [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-serif [&_h2]:text-title [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:font-serif [&_h3]:text-lead [&_h4]:mt-6 [&_h4]:mb-2 [&_h4]:font-semibold [&_li]:my-2 [&_ol]:my-4 [&_ol]:pl-6 [&_ol]:[list-style-type:decimal] [&_p]:my-4 [&_strong]:font-semibold [&_ul]:my-4 [&_ul]:pl-6 [&_ul]:[list-style-type:disc] [&_ul]:marker:text-secondary",
  inline: "[&_a]:link [&_a]:link-secondary [&_strong]:font-semibold [&_strong]:text-base-content",
  note: "[&_a]:link [&_a]:link-secondary [&_strong]:font-semibold [&_strong]:text-base-content",
};

interface Props {
  value: string | null | undefined;
  variant?: Variant;
}
const { value, variant = "prose" } = Astro.props;
const html = variant === "prose" ? renderMarkdown(value) : renderMarkdownInline(value);
---

{html && (variant === "prose" ? <div class={variants[variant]} set:html={html} /> : <p class={variants[variant]} set:html={html} />)}
