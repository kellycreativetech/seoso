---
import { ExternalLink } from "@lucide/astro";
import { eventDateParts, formatTime } from "../../lib/dates";
import { isPast } from "../../lib/events";
import { buildNow } from "../../lib/now";
import ButtonLink from "../ui/ButtonLink.astro";
import Container from "../ui/Container.astro";
import Markdown from "../sections/Markdown.astro";
import DetailHeader from "./DetailHeader.astro";

// Event page body; also used by the CMS preview.
export type EventView = {
  title: string;
  isNamedProgram?: boolean;
  start: Date;
  end?: Date | null;
  summary?: string | null;
  admission?: string | null;
  tickets?: string | null;
  body?: string | null;
  venue?: { name: string; city: string; address?: string | null; directions?: string | null; website?: string | null } | null;
};
const { event } = Astro.props as { event: EventView };
const date = eventDateParts(event.start.toISOString());
const past = isPast(event, buildNow(Astro.isPrerendered));
const venue = event.venue;
const label = "text-small font-semibold tracking-[0.14em] text-secondary uppercase";
---

<DetailHeader
  crumbs={[
    { label: "Events", href: "/events" },
    { label: past ? "Past events" : "Season", href: past ? "/events#past" : "/events#season" },
  ]}
  eyebrow={`${date.long} · ${date.time}${event.end ? `–${formatTime(event.end)}` : ""}`}
  title={event.title}
  italic={event.isNamedProgram}
  lead={event.summary}
>
  {
    event.tickets && !past && (
      <div>
        <ButtonLink link={{ label: "Get tickets", href: event.tickets }} />
      </div>
    )
  }
</DetailHeader>
<section class="py-16 sm:py-24">
  <Container>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <dl class="grid content-start gap-6 border-t-2 border-base-content pt-6 md:col-span-4">
        <div>
          <dt class={label}>When</dt>
          <dd class="mt-1 font-serif text-lead">{date.long}<br />{date.time}</dd>
        </div>
        {
          venue && (
            <div>
              <dt class={label}>Where</dt>
              <dd class="mt-1">
                <p class="font-serif text-lead">{venue.name}</p>
                <p class="whitespace-pre-line text-base-content/70">{venue.address ?? venue.city}</p>
                {venue.website && (
                  <a href={venue.website} rel="noopener noreferrer" class="link link-secondary mt-2 inline-flex items-center gap-1.5 text-small font-semibold">
                    Venue website <ExternalLink aria-hidden="true" class="size-3.5" />
                  </a>
                )}
              </dd>
            </div>
          )
        }
        {
          event.admission && (
            <div>
              <dt class={label}>Admission</dt>
              <dd class="mt-1 font-serif text-lead">{event.admission}</dd>
            </div>
          )
        }
      </dl>
      <div class="max-w-[62ch] md:col-span-7 md:col-start-6">
        {
          event.body ? (
            <Markdown value={event.body} />
          ) : (
            <p class="text-base-content/70">{past ? "This event has taken place." : "More details about this program are coming soon."}</p>
          )
        }
        {
          venue?.directions && (
            <div class="mt-10 border-t border-base-300 pt-6">
              <h2 class={label}>Directions</h2>
              <p class="mt-2">{venue.directions}</p>
            </div>
          )
        }
      </div>
    </div>
  </Container>
</section>
