---
import { X } from "@lucide/astro";
import type { SiteData } from "../../lib/site-data";
import ButtonLink from "../ui/ButtonLink.astro";
import NavLink from "./NavLink.astro";
import { DRAWER_ID } from "./drawer";

// daisyUI drawer wrapping the whole page; the sidebar is the mobile menu (below lg).
const { data } = Astro.props as { data: SiteData };
const { site, navigation } = data;
---

<div class="drawer drawer-end">
  <input id={DRAWER_ID} type="checkbox" class="drawer-toggle" aria-label="Toggle menu" />
  <div class="drawer-content flex min-h-screen flex-col"><slot /></div>
  <div class="drawer-side z-30">
    <label for={DRAWER_ID} aria-label="Close menu" class="drawer-overlay"></label>
    <aside class="flex min-h-full w-80 max-w-[85vw] flex-col gap-6 bg-neutral p-4 text-neutral-content">
      <div class="flex justify-end">
        <label for={DRAWER_ID} class="btn btn-sm btn-ghost text-neutral-content" aria-label="Close menu">
          <X aria-hidden="true" class="size-5" />
        </label>
      </div>
      <ul class="menu menu-lg w-full">
        {
          navigation.map((item) => (
            <li>
              <NavLink link={item} />
              {item.children.length > 0 && (
                <ul>
                  {item.children.map((child) => (
                    <li>
                      <NavLink link={child} />
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      {site.donateLink && <ButtonLink link={site.donateLink} variant="brandBlock" />}
    </aside>
  </div>
</div>
